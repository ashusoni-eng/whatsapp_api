# Port the Express server listens on
PORT=3000

# Shared secret required on every API request as ?api=...
API=change-me

# Optional: AI insights bot backend. Inbound WhatsApp messages are forwarded
# here, and the reply it returns is sent back to the sender. Leave both unset
# to disable the bot.
INSIGHTS_URL=
INSIGHTS_API_KEY=

# Optional: pin a specific WhatsApp Web build from wppconnect-team/wa-version
# (e.g. 2.3000.1054603161-alpha). Leave unset to track whatever WhatsApp
# serves — a stale pin causes scan-then-LOGOUT loops once the build is
# removed upstream.
WWEB_VERSION=

# Seconds to wait for "ready" after "authenticated" before restarting (default 360)
READY_TIMEOUT_SEC=360

# Set to 0 to launch a stock Chromium instead of the stripped-down one
# (images, sync, translate and extra renderer processes all re-enabled).
LEAN_BROWSER=1

# Local chat/media retention. The sweep runs every CHAT_SWEEP_HOURS and keeps
# chats touched within CHAT_KEEP_HOURS (0 = keep nothing). Clearing is local
# only - recipients keep everything we sent them.
CHAT_SWEEP_HOURS=24
CHAT_KEEP_HOURS=0
