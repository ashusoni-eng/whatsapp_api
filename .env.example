# Port the Express server listens on
PORT=3000

# Shared secret required on every API request as ?api=...
API=change-me

# Optional: AI insights bot backend. Inbound WhatsApp messages are forwarded
# here, and the reply it returns is sent back to the sender. Leave both unset
# to disable the bot.
INSIGHTS_URL=
INSIGHTS_API_KEY=

# Optional: pin a specific WhatsApp Web build from wppconnect-team/wa-version
# (e.g. 2.3000.1054603161-alpha). Leave unset to track whatever WhatsApp
# serves — a stale pin causes scan-then-LOGOUT loops once the build is
# removed upstream.
WWEB_VERSION=
